[Desktop Entry]
Name=Disk Usage Applet
Comment=Monitor de espaço em disco em tempo real para o painel do COSMIC Desktop
Exec=cosmic-applet-disk-usage
Terminal=false
Type=Application
StartupNotify=true
NotShowIn=COSMIC
Icon=com.wisk.cosmic-applet-disk-usage
Categories=COSMIC;Utility;System;
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
