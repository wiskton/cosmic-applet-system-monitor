[Desktop Entry]
Name=System Monitor Applet
Comment=Monitor de CPU, memória, GPU, armazenamento e rede para o COSMIC Desktop
Exec=cosmic-applet-system-monitor
Terminal=false
Type=Application
StartupNotify=true
NotShowIn=COSMIC
Icon=com.wisk.cosmic-applet-system-monitor
Categories=COSMIC;Utility;System;
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
